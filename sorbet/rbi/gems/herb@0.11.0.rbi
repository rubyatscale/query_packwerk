  def identifier_for(path); end

  # : (String, Pathname?) -> Array[String]
  #
  # source://herb//lib/herb/analysis/partial_resolver.rb#92
  def non_partial_matches(name, source_directory); end

  # : Pathname
  #
  # source://herb//lib/herb/analysis/partial_resolver.rb#32
  def project_path; end

  # : (String, ?from: (String | Pathname)?, ?format: String?) -> Resolved?
