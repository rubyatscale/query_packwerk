  # source://herb//lib/herb/analysis/partial_resolver.rb#46
  def resolve(name, from: T.unsafe(nil), format: T.unsafe(nil)); end

  # : (String, ?from: (String | Pathname)?, ?limit: Integer) -> Array[String]
