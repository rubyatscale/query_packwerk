# Lets a visitor declare the parser options the AST it is handed has to carry, so that
# whoever parses can satisfy them before visiting.
#
#     class PrismProgramVisitor < Herb::Visitor
#       required_parser_option prism_program: true
#       recommended_parser_option strict: false
#     end
#
# A required option is one the visitor cannot work without, and a recommended one is a soft
# requirement it only works better with. `Herb::Visitor.parser_options_for` resolves both for
# a set of visitors, raising on a conflicting requirement and warning on a conflicting
# recommendation.
#
# `Herb::Visitor` includes this, so every visitor has it. Anything else that is passed to
# `Herb::Engine` as a visitor can include it too.
#
# pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:22
module Herb::Visitor::ParserOptionRequirements
  mixes_in_class_methods ::Herb::Visitor::ParserOptionRequirements::ClassMethods

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:134
  sig { returns(T::Hash[::Symbol, T.untyped]) }
  def recommended_parser_options; end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:129
  sig { returns(T::Hash[::Symbol, T.untyped]) }
  def required_parser_options; end

  private

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:146
  sig { returns(T.untyped) }
  def declaring_class; end

  class << self
    # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:139
    sig { params(object: T.untyped).returns(T.untyped) }
    def class_of(object); end

    # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:24
    sig { params(base: T.untyped).void }
    def included(base); end
  end
end

# pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:30
module Herb::Visitor::ParserOptionRequirements::ClassMethods
  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:52
  sig { params(subclass: T.untyped).void }
  def inherited(subclass); end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:60
  sig do
    params(
      visitors: T::Array[T.untyped],
      parser_options: T::Hash[::Symbol, T.untyped]
    ).returns(T::Hash[::Symbol, T.untyped])
  end
  def parser_options_for(visitors, parser_options = T.unsafe(nil)); end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:37
  sig { params(options: T.untyped).void }
  def recommended_parser_option(**options); end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:47
  sig { returns(T::Hash[::Symbol, T.untyped]) }
  def recommended_parser_options; end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:32
  sig { params(options: T.untyped).void }
  def required_parser_option(**options); end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:42
  sig { returns(T::Hash[::Symbol, T.untyped]) }
  def required_parser_options; end

  private

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:88
  sig { params(visitors: T::Array[T.untyped], options: T::Hash[::Symbol, T.untyped]).void }
  def apply_recommended_parser_options(visitors, options); end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:72
  sig { params(visitors: T::Array[T.untyped], options: T::Hash[::Symbol, T.untyped]).void }
  def apply_required_parser_options(visitors, options); end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:105
  sig { params(kind: ::Symbol).returns(T::Hash[::Symbol, T.untyped]) }
  def declared_parser_options(kind); end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:123
  sig { params(visitor: T.untyped).returns(::String) }
  def describe(visitor); end

  # pkg:gem/herb#lib/herb/visitor/parser_option_requirements.rb:112
  def each_declared_parser_option(visitors, reader); end
end

