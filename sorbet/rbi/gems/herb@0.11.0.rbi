  def identifier_for(path); end

  # pkg:gem/herb#lib/herb/analysis/partial_resolver.rb:92
  sig { params(name: ::String, source_directory: T.nilable(::Pathname)).returns(T::Array[::String]) }
  def non_partial_matches(name, source_directory); end

  # pkg:gem/herb#lib/herb/analysis/partial_resolver.rb:32
  def project_path; end

  # pkg:gem/herb#lib/herb/analysis/partial_resolver.rb:46
  sig do
    params(
      name: ::String,
